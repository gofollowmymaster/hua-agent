generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Subapp {
  id         Int       @id @default(autoincrement())
  subappName String    @unique
  versions   Version[]
}

model Version {
  id           Int          @id @default(autoincrement())
  versionName  String       @unique
  versionEntry String
  subappId     Int
  headerTags   HeaderTags[]
  subapp       Subapp       @relation(fields: [subappId], references: [id])
}

model HeaderTags {
  id        Int     @id @default(autoincrement())
  versionId Int
  tagKey    String
  tagValue  String
  version   Version @relation(fields: [versionId], references: [id])
}
