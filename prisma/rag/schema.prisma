generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/rag-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("RAG_DATABASE_URL")
}

model AplusDocument {
  id         BigInt       @id @default(autoincrement())
  tenantCode String       @map("tenant_code") @db.Text
  sourcePath String       @map("source_path") @db.Text
  fileName   String       @map("file_name") @db.Text
  fileType   String       @map("file_type") @db.Text
  fileHash   String       @map("file_hash") @db.Text
  fileSize   BigInt       @map("file_size")
  chunkCount Int          @default(0) @map("chunk_count")
  status     String       @default("ready") @db.Text
  error      String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  ingestedAt DateTime?    @map("ingested_at") @db.Timestamptz(6)
  chunks     AplusChunk[]

  @@unique([tenantCode, sourcePath])
  @@index([tenantCode], map: "idx_aplus_documents_tenant_code")
  @@map("aplus_documents")
}

model AplusChunk {
  id         BigInt                @id @default(autoincrement())
  tenantCode String                @map("tenant_code") @db.Text
  documentId BigInt                @map("document_id")
  chunkIndex Int                   @map("chunk_index")
  content    String                @db.Text
  metadata   Json                  @default("{}") @db.JsonB
  embedding  Unsupported("vector")
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  document   AplusDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([tenantCode, documentId, chunkIndex])
  @@index([tenantCode], map: "idx_aplus_chunks_tenant_code")
  @@index([documentId], map: "idx_aplus_chunks_document_id")
  @@index([tenantCode, documentId], map: "idx_aplus_chunks_tenant_document")
  @@map("aplus_chunks")
}
