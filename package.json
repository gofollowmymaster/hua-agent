{
  "name": "aplus-sql-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:dev": "dotenv -e .env.dev.local   -e .env.dev -e .env ",
    "env:test": "dotenv -e .env.test.local  -e .env.test -e .env    ",
    "env:prod": "dotenv -e .env.prod.local  -e .env.prod  -e .env  ",
    "env:prod-boat": "dotenv  -e .env.prod-boat.local -e .env.prod-boat -e .env   ",
    "build:dev": "pnpm env:dev -- nest build",
    "build:test": "pnpm env:test -- nest build",
    "build:prod": "pnpm env:prod -- nest build",
    "build:prod-boat": "pnpm env:prod-boat -- nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migrate:dev": "pnpm env:dev -- npx prisma migrate dev --create-only",
    "migrate:test": "pnpm env:test -- npx prisma migrate dev --create-only",
    "migrate:prod": "pnpm env:prod -- npx prisma migrate dev",
    "migrate:prod-boat": "pnpm env:prod-boat -- npx prisma migrate dev",
    "start": "pnpm env:dev --  nest start",
    "start:dev": "pnpm env:dev -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:test": "pnpm env:test -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "nest start --debug --watch",
    "deploy:prod": "pnpm build:prod && pm2 start ecosystem.config.js --env prod",
    "deploy:dev": "pnpm build:dev && pm2 start ecosystem.config.js --env dev",
    "deploy:test": "pnpm build:test && pm2 start ecosystem.config.js --env test",
    "docker:prod": "TZ=Asia/Shanghai && pnpm env:prod -- pm2-runtime ecosystem.config.js --env prod",
    "docker:prod-boat": "TZ=Asia/Shanghai && pnpm env:prod-boat -- pm2-runtime ecosystem.config.js --env prod",
    "docker:dev": "TZ=Asia/Shanghai && pnpm env:dev -- pm2-runtime ecosystem.config.js --env dev",
    "docker:test": "TZ=Asia/Shanghai && pnpm env:test -- pm2-runtime ecosystem.config.js --env test",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "pg": "prisma generate",
    "pf": "prisma format",
    "pmd": "prisma migrate dev",
    "pmSdo": "prisma studio"
  },
  "dependencies": {
    "@keyv/redis": "^4.4.0",
