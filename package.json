{
  "name": "aplus-sql-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:dev": "pnpm dotenv -e .env -e .env.dev",
    "env:test": "pnpm dotenv -e .env -e .env.test",
    "env:prod": "pnpm dotenv -e .env -e .env.prod",
    "build:dev": "pnpm env:dev -- nest build",
    "build:test": "pnpm env:test -- nest build",
    "build:prod": "pnpm env:prod -- nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migrate:dev": "pnpm env:dev -- npx prisma migrate dev --create-only",
    "migrate:test": "pnpm env:test -- npx prisma migrate dev --create-only",
    "migrate:prod": "pnpm env:prod -- npx prisma migrate deploy",
    "start": "nest start",
    "start:dev": "pnpm env:dev -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:test": "pnpm env:test -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "nest start --debug --watch",
    "deploy:prod": "pnpm build:prod && pm2 start ecosystem.config.js --env prod",
    "deploy:dev": "pnpm build:dev && pm2 start ecosystem.config.js --env dev",
    "deploy:test": "pnpm build:test && pm2 start ecosystem.config.js --env test",
    "docker:prod": "pnpm build:prod && TZ=Asia/Shanghai && pnpm env:prod -- pm2-runtime ecosystem.config.js --env prod",
    "docker:dev": "pnpm build:dev &&  TZ=Asia/Shanghai && pnpm env:dev -- pm2-runtime ecosystem.config.js --env dev",
    "docker:test": "pnpm build:test && TZ=Asia/Shanghai && pnpm env:test -- pm2-runtime ecosystem.config.js --env test",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "pg": "prisma generate",
    "pf": "prisma format",
    "pmd": "prisma migrate dev",
    "pmSdo": "prisma studio"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.39.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@prisma/client": "5.16.1",
    "body-parser": "^1.20.3",
    "chinese-workday": "^1.10.0",
    "dayjs": "^1.11.13",
    "dotenv-cli": "^7.4.2",
    "fs-extra": "^11.2.0",
    "pm2": "^5.4.1",
    "prisma": "^5.16.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "run-script-webpack-plugin": "^0.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "webpack": "^5.92.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
