{
  "name": "aplus-sql-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @aplus-sql/api --filter @aplus-sql/rag-admin --filter @aplus-sql/react-admin -r run build:dev",
    "build:dev": "pnpm --filter @aplus-sql/api build:dev",
    "build:test": "pnpm --filter @aplus-sql/api build:test",
    "build:prod": "pnpm --filter @aplus-sql/api build:prod",
    "format": "pnpm --filter @aplus-sql/api format",
    "prepare": "husky",
    "migrate:dev": "pnpm --filter @aplus-sql/api migrate:dev",
    "migrate:test": "pnpm --filter @aplus-sql/api migrate:test",
    "migrate:prod": "pnpm --filter @aplus-sql/api migrate:prod",
    "start": "pnpm --filter @aplus-sql/api start",
    "start:dev": "pnpm --filter @aplus-sql/api start:dev  ",
    "start:test": "pnpm --filter @aplus-sql/api start:test",
    "start:debug": "pnpm --filter @aplus-sql/api start:debug",
    "docker:prod": "pnpm --filter @aplus-sql/api docker:prod",
    "docker:dev": "pnpm --filter @aplus-sql/api docker:dev",
    "docker:test": "pnpm --filter @aplus-sql/api docker:test",
    "lint": "pnpm --filter @aplus-sql/api lint",
    "lint:check": "pnpm --filter @aplus-sql/api lint:check",
    "pg:rag": "pnpm --filter @aplus-sql/api pg:rag",
    "pg": "pnpm --filter @aplus-sql/api pg",
    "pf": "pnpm --filter @aplus-sql/api pf",
    "pmd": "pnpm --filter @aplus-sql/api pmd",
    "pmSdo": "pnpm --filter @aplus-sql/api pmSdo",
    "test": "pnpm --filter @aplus-sql/api test",
    "test:cov": "pnpm --filter @aplus-sql/api test:cov",
    "rag:db:init": "pnpm --filter @aplus-sql/api rag:db:init",
    "agent:ingest": "pnpm --filter @aplus-sql/api agent:ingest",
    "admin:dev": "pnpm --filter @aplus-sql/rag-admin dev",
    "admin:build": "pnpm --filter @aplus-sql/rag-admin build",
    "admin:preview": "pnpm --filter @aplus-sql/rag-admin preview",
    "admin:lint": "pnpm --filter @aplus-sql/rag-admin lint",
    "admin:lint:check": "pnpm --filter @aplus-sql/rag-admin lint:check",
    "admin:format": "pnpm --filter @aplus-sql/rag-admin format",
    "admin:format:check": "pnpm --filter @aplus-sql/rag-admin format:check",
    "admin:stylelint": "pnpm --filter @aplus-sql/rag-admin stylelint",
    "admin:stylelint:check": "pnpm --filter @aplus-sql/rag-admin stylelint:check",
    "react-admin:dev": "pnpm --filter @aplus-sql/react-admin dev",
    "react-admin:build": "pnpm --filter @aplus-sql/react-admin build",
    "react-admin:preview": "pnpm --filter @aplus-sql/react-admin preview",
    "react-admin:test": "pnpm --filter @aplus-sql/react-admin test",
    "react-admin:e2e": "pnpm --filter @aplus-sql/react-admin e2e",
    "react-admin:typecheck": "pnpm --filter @aplus-sql/react-admin typecheck",
    "react-admin:antd:info": "pnpm --filter @aplus-sql/react-admin antd:info",
    "react-admin:antd:lint": "pnpm --filter @aplus-sql/react-admin antd:lint",
    "react-admin:check": "pnpm --filter @aplus-sql/react-admin check",
    "react-admin:lint": "pnpm --filter @aplus-sql/react-admin lint",
    "react-admin:lint:check": "pnpm --filter @aplus-sql/react-admin lint:check",
    "react-admin:format": "pnpm --filter @aplus-sql/react-admin format",
    "react-admin:format:check": "pnpm --filter @aplus-sql/react-admin format:check",
    "python-api:sync": "uv sync --project apps/python-api --python 3.12",
    "python-api:dev": "cross-env PYTHON_API_ENV=dev uv run --project apps/python-api python -m python_api.run",
    "python-api:start": "cross-env PYTHON_API_ENV=prod uv run --project apps/python-api python -m python_api.run",
    "python-api:test": "cross-env PYTHON_API_ENV=test uv run --project apps/python-api pytest apps/python-api/tests",
    "python-api:test:integration": "uv run --project apps/python-api python apps/python-api/scripts/run_integration_tests.py",
    "python-api:test:all": "pnpm python-api:test && pnpm python-api:test:integration",
    "python-api:lint": "uv run --project apps/python-api ruff check apps/python-api",
    "python-api:typecheck": "uv run --project apps/python-api mypy --config-file apps/python-api/pyproject.toml apps/python-api/src",
    "python-api:build": "uv build --project apps/python-api",
    "ui-kit:build": "pnpm --filter @aplus-sql/ui-kit build",
    "ui-kit:test": "pnpm --filter @aplus-sql/ui-kit test",
    "ui-kit:lint:check": "pnpm --filter @aplus-sql/ui-kit lint:check",
    "ui-kit:stylelint:check": "pnpm --filter @aplus-sql/ui-kit stylelint:check",
    "react-ui-kit:build": "pnpm --filter @aplus-sql/react-ui-kit build",
    "react-ui-kit:test": "pnpm --filter @aplus-sql/react-ui-kit test",
    "react-ui-kit:lint:check": "pnpm --filter @aplus-sql/react-ui-kit lint:check",
    "react-ui-kit:format:check": "pnpm --filter @aplus-sql/react-ui-kit format:check",
    "http-client:build": "pnpm --filter @aplus-sql/http-client build",
    "http-client:test": "pnpm --filter @aplus-sql/http-client test",
    "http-client:lint:check": "pnpm --filter @aplus-sql/http-client lint:check"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @aplus-sql/api exec eslint --max-warnings 0",
    "apps/rag-admin/src/**/*.{ts,vue}": "pnpm --filter @aplus-sql/rag-admin exec eslint --max-warnings 0",
    "apps/react-admin/**/*.{ts,tsx}": "pnpm --filter @aplus-sql/react-admin exec eslint --max-warnings 0",
    "packages/ui-kit/**/*.{ts,vue}": "pnpm --filter @aplus-sql/ui-kit exec eslint --max-warnings 0",
    "packages/react-ui-kit/**/*.{ts,tsx}": "pnpm --filter @aplus-sql/react-ui-kit exec eslint --max-warnings 0",
    "packages/http-client/**/*.ts": "pnpm --filter @aplus-sql/http-client exec eslint --max-warnings 0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
