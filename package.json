{
  "name": "aplus-sql-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:dev": "pnpm --filter @aplus-sql/api build:dev",
    "build:test": "pnpm --filter @aplus-sql/api build:test",
    "build:prod": "pnpm --filter @aplus-sql/api build:prod",
    "format": "pnpm --filter @aplus-sql/api format",
    "prepare": "husky",
    "migrate:dev": "pnpm --filter @aplus-sql/api migrate:dev",
    "migrate:test": "pnpm --filter @aplus-sql/api migrate:test",
    "migrate:prod": "pnpm --filter @aplus-sql/api migrate:prod",
    "start": "pnpm --filter @aplus-sql/api start",
    "start:dev": "pnpm --filter @aplus-sql/api start:dev  ",
    "start:test": "pnpm --filter @aplus-sql/api start:test",
    "start:debug": "pnpm --filter @aplus-sql/api start:debug",
    "docker:prod": "pnpm --filter @aplus-sql/api docker:prod",
    "docker:dev": "pnpm --filter @aplus-sql/api docker:dev",
    "docker:test": "pnpm --filter @aplus-sql/api docker:test",
    "lint": "pnpm --filter @aplus-sql/api lint",
    "lint:check": "pnpm --filter @aplus-sql/api lint:check",
    "pg:mysql": "pnpm --filter @aplus-sql/api pg:mysql",
    "pg:rag": "pnpm --filter @aplus-sql/api pg:rag",
    "pg": "pnpm --filter @aplus-sql/api pg",
    "pf": "pnpm --filter @aplus-sql/api pf",
    "pmd": "pnpm --filter @aplus-sql/api pmd",
    "pmSdo": "pnpm --filter @aplus-sql/api pmSdo",
    "test": "pnpm --filter @aplus-sql/api test",
    "test:cov": "pnpm --filter @aplus-sql/api test:cov",
    "rag:db:init": "pnpm --filter @aplus-sql/api rag:db:init",
    "admin:dev": "pnpm --filter @aplus-sql/rag-admin dev",
    "admin:build": "pnpm --filter @aplus-sql/rag-admin build",
    "admin:preview": "pnpm --filter @aplus-sql/rag-admin preview",
    "admin:lint": "pnpm --filter @aplus-sql/rag-admin lint",
    "admin:lint:check": "pnpm --filter @aplus-sql/rag-admin lint:check",
    "admin:format": "pnpm --filter @aplus-sql/rag-admin format",
    "admin:format:check": "pnpm --filter @aplus-sql/rag-admin format:check"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter @aplus-sql/api exec eslint --max-warnings 0",
    "apps/rag-admin/src/**/*.{ts,vue}": "pnpm --filter @aplus-sql/rag-admin exec eslint --max-warnings 0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "dotenv-cli": "^7.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}
