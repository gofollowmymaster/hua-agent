pipeline {
    agent any

    environment {
        REGISTRY = 'registry.cn-hangzhou.aliyuncs.com'
        INTERIOR_REGISTRY = 'registry.cn-hangzhou.aliyuncs.com'
        IMAGE_NAMESPACE = 'app-backend'
        IMAGE_NAME = 'aplus-sql-service'
        DOCKER_FILE = 'Dockerfile'
        DOCKER_COMPOSE_FILE = 'buildfile/docker-compose.yaml'
        K8S_FILE = 'buildfile/k8s-deploy.yaml'
    }

    stages {
        stage('environment variable') {
            steps {
                script {
                    def configFileId
                    switch (PROFILE) {
                        case 'test':
                            configFileId = 'be69e564-3c77-4500-9d2e-1e65e7ca911a'
                            break
                        case 'dev':
                            configFileId = '51a337aa-5920-4efc-87ef-f08302d60d65'
                            break
                        case 'prod':
                            configFileId = '7f18a008-d938-48bd-8220-08dac11d4687'
                            break
                        default:
                            sh 'echo "No inject environment"'
                            return
                    }
                    configFileProvider([configFile(fileId: configFileId, targetLocation: 'OTEL_ENV_FILE', variable: 'OTEL_ENV')]) {
                        script {
                            def config = readFile("${OTEL_ENV}").trim()
                            config.split('\n').each { line ->
                                def parts = line.split('=')
                                if (parts.size() == 2) {
                                    env[parts[0].trim()] = parts[1].trim()
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('compile & buildImage->push') {
            steps {
                  //sh 'export tag=$PROFILE-$BUILD_ID && envsubst < $K8S_FILE > docker-compose-deploy.yaml'
                script {
                    sh "npm config set registry https://registry.npmmirror.com "
                    sh "export NODE_OPTIONS=--max-old-space-size=16384"
                    sh "/usr/local/bin/corepack enable"
                    sh "pnpm install"
                    sh "pnpm install -g npx"
                    sh "pnpm migrate:dev"
                    sh "pnpm build"
                }
                
                withDockerServer([credentialsId: '', uri: 'unix:///var/run/docker.sock']) {
                    withCredentials([usernamePassword(credentialsId: 'aliyunimage', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh 'echo "$DOCKER_PASSWORD" | docker login $INTERIOR_REGISTRY -u "$DOCKER_USERNAME" --password-stdin'
                        sh 'docker build -f  $DOCKER_FILE -t $INTERIOR_REGISTRY/$IMAGE_NAMESPACE/$IMAGE_NAME:$PROFILE-$BUILD_ID .'
                        sh 'echo "push start..."'
                        sh 'docker push $INTERIOR_REGISTRY/$IMAGE_NAMESPACE/$IMAGE_NAME:$PROFILE-$BUILD_ID'
                    }
                }
            }
        }

        stage('deploy') {
            agent none
            steps {
                sh 'export tag=$PROFILE-$BUILD_ID && envsubst < $DOCKER_COMPOSE_FILE > docker-compose-deploy.yaml'
                script {
                    def dockerCredentialsId
                    def dockerUri
                    switch (PROFILE) {
                        case 'test':
                            dockerCredentialsId = '19891f18-a3ab-4c58-b0ca-ae11a6d22eda'
                            dockerUri = 'tcp://192.168.6.101:2375'
                            withDockerServer([credentialsId: dockerCredentialsId, uri: dockerUri]) {
                                sh "docker-compose -f docker-compose-deploy.yaml up -d"
                            }
                            break
                        case 'dev':
                            dockerCredentialsId = 'docker-dev-4c58-b0ca-ae11a6d22eda'
                            dockerUri = 'tcp://192.168.6.103:2375'
                            withDockerServer([credentialsId: dockerCredentialsId, uri: dockerUri]) {
                                sh "docker-compose -f docker-compose-deploy.yaml up -d"
                            }
                            break
                        case 'prod':
                            sh 'export tag=$PROFILE-$BUILD_ID && envsubst < $K8S_FILE | kubectl apply -f -'
                            break
                        default:
                            sh 'echo "No deployment"'
                            return
                    }
                }
            }
        }
    }
}
