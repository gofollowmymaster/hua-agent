# Environment selection: dev, test, or prod. Process variables override all files.
PYTHON_API_ENV=dev
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=8000
PYTHON_API_WORKERS=1
PYTHON_API_RELOAD=false
PYTHON_API_DOCS_ENABLED=true
PYTHON_API_LOG_LEVEL=INFO

# Required core dependencies
RAG_DATABASE_URL=
JWT_SECRET=
JWT_TOKEN_EXPIRED_TIME=7
DEFAULT_TENANT=aplus

# Canonical Redis variables. DB_REDIS_* aliases remain temporarily supported.
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_READ_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# PostgreSQL pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_PRE_PING=true

# HTTP and middleware
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
PYTHON_API_MAX_REQUEST_SIZE_BYTES=52428800
PYTHON_API_MAX_UPLOAD_FILES=20
PYTHON_API_MAX_UPLOAD_SIZE_BYTES=52428800

# OpenAI-compatible chat and embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=qwen-plus
RAG_QUERY_REWRITE_MODEL=qwen-turbo
RAG_REASONING_EFFORT=xhigh
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL_NAME=text-embedding-v3
EMBEDDINGS_DIMENSIONS=1024

# Optional rerank provider
RERANK_API_KEY=
RERANK_URL=
RERANK_MODEL=qwen3-rerank
RERANK_TIMEOUT_MS=10000
RAG_RERANK_MODE=rule
RAG_VECTOR_TOP_K=8
RAG_KEYWORD_TOP_K=8
RAG_FUSION_K=60
RAG_RERANK_TOP_N=30

# RAG and Agent tuning
RAW_DIR=raw
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_BATCH_SIZE=10
RAG_DEFAULT_TOP_K=8
RAG_PROMPT_VERSION=v1
AGENT_DOCS_DIR=src/agent/docs
AGENT_CHUNK_SIZE=800
AGENT_CHUNK_OVERLAP=120
AGENT_EMBEDDING_BATCH_SIZE=10

# Optional Feishu integration
FEISHU_ALERT_APP_APPID=
FEISHU_ALERT_APP_APPSECRET=
FEISHU_APLUS_NODE_ADMIN_APP_TOKEN=
SERVER_ALERT_GROUPID=
FEISHU_SMOKE_TEST_ENABLED=false

# Optional local administrator bootstrap; username and password must be set together.
RAG_ADMIN_BOOTSTRAP_USERNAME=
RAG_ADMIN_BOOTSTRAP_PASSWORD=
RAG_ADMIN_BOOTSTRAP_SUPPLIER_CODE=A
RAG_ADMIN_BOOTSTRAP_DISPLAY_NAME=
RAG_ADMIN_BOOTSTRAP_RESET_PASSWORD=false
