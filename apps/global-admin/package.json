{
  "name": "@aplus-sql/global-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "dev": "vite --host 0.0.0.0",
    "dev:test": "vite --host 0.0.0.0 --mode test",
    "format": "prettier --write \"src/**/*.{ts,vue,less}\" index.html vite.config.ts eslint.config.js prettier.config.cjs stylelint.config.cjs tsconfig.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,vue,less}\" index.html vite.config.ts eslint.config.js prettier.config.cjs stylelint.config.cjs tsconfig.json package.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 \"src/**/*.{vue,ts}\" --fix",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 \"src/**/*.{vue,ts}\"",
    "preview": "vite preview --host 0.0.0.0",
    "stylelint": "stylelint \"src/**/*.{vue,css,less}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "stylelint:check": "stylelint \"src/**/*.{vue,css,less}\" --cache --cache-location node_modules/.cache/stylelint/",
    "test": "vitest run"
  },
  "dependencies": {
    "@aplus-frontend/antdv": "2.2.0",
    "@aplus-frontend/aplus-auth-sdk": "2.1.4",
    "@aplus-frontend/ui": "7.26.8",
    "@aplus-sql/http-client": "workspace:*",
    "@aplus-sql/ui-kit": "workspace:*",
    "@open-file-viewer/core": "0.1.17",
    "@open-file-viewer/vue": "0.1.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vite": "7.1.12",
    "vue": "3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "^22.13.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "happy-dom": "^18.0.1",
    "less": "^4.8.1",
    "postcss-html": "^1.7.0",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "stylelint": "^16.7.0",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "catalog:",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "^2.2.4"
  }
}
