{
  "name": "@aplus-sql/react-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "max build",
    "build:dev": "max build",
    "build:test": "cross-env UMI_ENV=test max build",
    "dev": "dotenv -e .env.development -- cross-env PORT=5175 HOST=0.0.0.0 max dev",
    "preview": "max preview --port 4175",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 .umirc.ts playwright.config.ts \"config/**/*.ts\" \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" --fix",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 .umirc.ts playwright.config.ts \"config/**/*.ts\" \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,tsx}\" \"config/**/*.ts\" .umirc.ts eslint.config.js playwright.config.ts prettier.config.cjs tsconfig.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,tsx}\" \"config/**/*.ts\" .umirc.ts eslint.config.js playwright.config.ts prettier.config.cjs tsconfig.json package.json",
    "typecheck": "tsc --noEmit",
    "antd:info": "antd info",
    "antd:lint": "antd lint ./src",
    "check": "pnpm typecheck && pnpm lint:check && pnpm format:check && pnpm antd:lint && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.130",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/pro-components": "3.1.15-5",
    "@aplus-sql/http-client": "workspace:*",
    "@open-file-viewer/core": "0.1.17",
    "@umijs/max": "4.7.22",
    "ai": "6.0.148",
    "antd": "6.6.5",
    "dayjs": "^1.11.13",
    "pdfjs-dist": "6.1.200",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.5",
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "catalog:",
    "happy-dom": "^18.0.1",
    "prettier": "catalog:",
    "typescript": "5.7.2",
    "typescript-eslint": "catalog:",
    "vite": "7.1.12",
    "vitest": "^3.2.4"
  }
}
