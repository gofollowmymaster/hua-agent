{
  "name": "@aplus-sql/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:dev": "dotenv -e .env.dev.local -e .env.dev -e .env",
    "env:test": "dotenv -e .env.test.local -e .env.test -e .env",
    "env:prod": "dotenv -e .env.prod.local -e .env.prod -e .env",
    "build:dev": "pnpm env:dev -- nest build",
    "build:test": "pnpm env:test -- nest build",
    "build:prod": "pnpm env:prod -- nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migrate:dev": "pnpm env:dev -- npx prisma migrate dev --create-only --schema prisma/schema.prisma",
    "migrate:test": "pnpm env:test -- npx prisma migrate dev --create-only --schema prisma/schema.prisma",
    "migrate:prod": "pnpm env:prod -- npx prisma migrate deploy --schema prisma/schema.prisma",
    "start": "pnpm env:prod -- nest start",
    "start:dev": "pnpm env:dev -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:test": "pnpm env:test -- nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "pnpm env:test -- nest start --debug --watch",
    "docker:prod": "TZ=Asia/Shanghai pnpm env:prod -- pm2-runtime ecosystem.config.js --env prod",
    "docker:dev": "TZ=Asia/Shanghai pnpm env:dev -- pm2-runtime ecosystem.config.js --env dev",
    "docker:test": "TZ=Asia/Shanghai pnpm env:test -- pm2-runtime ecosystem.config.js --env test",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "pg:rag": "prisma generate --schema prisma/rag/schema.prisma",
    "pg": "pnpm pg:rag",
    "pf": "prisma format --schema prisma/schema.prisma && prisma format --schema prisma/rag/schema.prisma",
    "pmd": "prisma migrate dev --schema prisma/schema.prisma",
    "pmSdo": "prisma studio --schema prisma/schema.prisma",
    "rag:db:init": "pnpm rag:db:init:dev",
    "rag:db:init:dev": "pnpm env:dev -- node scripts/rag-db-init.mjs",
    "rag:db:init:test": "pnpm env:test -- node scripts/rag-db-init.mjs",
    "rag:db:init:prod": "pnpm env:prod -- node scripts/rag-db-init.mjs",
    "rag:db:check": "pnpm rag:db:check:dev",
    "rag:db:check:dev": "pnpm env:dev -- node scripts/rag-db-init.mjs --check",
    "rag:db:check:test": "pnpm env:test -- node scripts/rag-db-init.mjs --check",
    "rag:db:check:prod": "pnpm env:prod -- node scripts/rag-db-init.mjs --check",
    "agent:ingest": "pnpm env:dev -- ts-node -r tsconfig-paths/register scripts/agent-knowledge-ingest.ts",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.10.0",
    "@langchain/openai": "^1.5.11",
    "@langchain/textsplitters": "^1.0.1",
    "@larksuiteoapi/node-sdk": "^1.54.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/devtools-integration": "^0.2.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "8.1.0",
    "@prisma/client": "5.16.1",
    "ai": "6.0.148",
    "axios": "^1.9.0",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.13",
    "deepagents": "^1.12.2",
    "fast-xml-parser": "^5.3.2",
    "fs-extra": "^11.2.0",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.1",
    "langchain": "^1.5.5",
    "langsmith": "^0.7.15",
    "lodash": "^4.17.21",
    "mammoth": "^1.11.0",
    "multer": "1.4.4-lts.1",
    "officeparser": "^6.0.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "prisma": "^5.16.1",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.2",
    "@types/lodash-es": "^4.17.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "^29.5.0",
    "pm2": "^5.4.1",
    "prettier": "catalog:",
    "run-script-webpack-plugin": "^0.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "catalog:",
    "webpack": "^5.92.1",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/$1"
    }
  }
}
