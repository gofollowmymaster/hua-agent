{
  "name": "@aplus-sql/rag-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "dev": "vite --host 0.0.0.0",
    "dev:test": "vite --host 0.0.0.0 --mode test",
    "format": "prettier --write \"src/**/*.{ts,vue,less}\" index.html vite.config.ts eslint.config.js prettier.config.cjs tsconfig.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,vue,less}\" index.html vite.config.ts eslint.config.js prettier.config.cjs tsconfig.json package.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 \"src/**/*.{vue,ts}\" --fix",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0 \"src/**/*.{vue,ts}\"",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ai-sdk/vue": "3.0.148",
    "@aplus-frontend/antdv": "2.2.0",
    "@aplus-frontend/aplus-auth-sdk": "2.1.4",
    "@aplus-frontend/ui": "7.26.8",
    "@open-file-viewer/core": "0.1.17",
    "@open-file-viewer/vue": "0.1.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "ai": "6.0.148",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "js-cookie": "^3.0.5",
    "md-editor-v3": "^6.5.3",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^2.3.1",
    "vite": "7.1.12",
    "vue": "3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.13.5",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "globals": "catalog:",
    "less": "^4.8.1",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "typescript": "5.7.2",
    "typescript-eslint": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "^2.2.4"
  }
}
